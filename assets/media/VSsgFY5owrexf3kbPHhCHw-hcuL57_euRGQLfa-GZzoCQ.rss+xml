<style>
.ep-game-container{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;max-width:700px;margin:20px auto;padding:15px;border-radius:12px;background:#fff;box-shadow:0 8px 20px rgba(0,0,0,.08);border:1px solid #e9ecef}.ep-game-container .game-stage{margin-bottom:40px;padding-bottom:20px;border-bottom:1px solid #eee;display:none}.ep-game-container .game-stage.active{display:block;animation:epq-in .5s ease forwards}@keyframes epq-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}.ep-game-container h2{font-family:"Georgia",serif;font-size:clamp(20px,5vw,26px);margin-bottom:15px;color:#222;line-height:1.3}.ep-game-container .stage-counter{font-size:clamp(16px,4vw,20px);color:#888;margin-bottom:10px;font-family:"Georgia",serif}.ep-game-container .game-stage img{width:100%;border-radius:10px;margin-bottom:20px;height:auto;object-fit:cover;max-height:400px}.ep-game-container .choices-container{display:flex;flex-direction:column;gap:12px}.ep-game-container .choice-option{padding:15px;border:1px solid #ddd;border-radius:8px;cursor:pointer;transition:all .25s;font-size:clamp(16px,4vw,18px);text-align:center;background:#fff;user-select:none}.ep-game-container .choice-option:not(.disabled):hover{background:#f0f0f0;border-color:#aaa;transform:translateY(-2px)}.ep-game-container .choice-option.correct{background:#d4edda!important;border-color:#28a745!important;color:#155724;font-weight:700}.ep-game-container .choice-option.incorrect{background:#f8d7da!important;border-color:#dc3545!important;color:#721c24;font-weight:700}.ep-game-container .choice-option.disabled{cursor:not-allowed;opacity:.7;transform:none!important}.ep-game-container .feedback{margin-top:15px;padding:12px;border-radius:8px;font-size:clamp(14px,3.5vw,16px);background:#f7f7f7;border:1px solid #e0e0e0;display:none;line-height:1.5}#game-results{text-align:center;padding:20px;display:none}.ep-game-container #game-results.active{display:block;animation:epq-in .5s ease forwards}.ep-game-container #game-results h2{font-family:"Georgia",serif;font-size:clamp(24px,5vw,32px);color:#222}.ep-game-container #game-results p{font-size:clamp(16px,4vw,20px);color:#555;margin:10px 0 20px}.ep-game-container #game-results img{max-width:100%;border-radius:8px;margin-top:20px;max-height:300px;object-fit:cover}.ep-game-container #restart-game-btn{margin-top:20px;padding:14px 25px;font-size:clamp(16px,4vw,18px);cursor:pointer;border-radius:8px;border:none;background:#007bff;color:#fff}.ep-game-container #restart-game-btn:hover{background:#0056b3}#game-intro{text-align:center;padding:20px}.ep-game-container #start-game-btn{margin-top:20px;padding:14px 25px;font-size:clamp(16px,4vw,18px);cursor:pointer;border-radius:8px;border:none;background:#28a745;color:#fff}.ep-game-container #start-game-btn:hover{background:#218838}.game-share{margin-top:30px;padding-top:20px;border-top:1px solid #eee}.ep-game-container .game-share p{font-size:16px;font-weight:700;margin-bottom:15px;color:#333}.share-row{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}.share-btn{flex:1 1 100px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px;font-size:16px;font-weight:700;border:none;border-radius:8px;cursor:pointer;transition:opacity .25s;min-width:140px;text-decoration:none;color:#fff}.share-btn:hover{opacity:.85}.share-btn.share-native{background-color:#20c997}.share-btn.copy-link{background-color:#6c5ce7}#copy-feedback{margin-top:10px;text-align:center;color:#28a745;font-weight:700;display:none}@media (prefers-color-scheme:dark){.ep-game-container{background:#2d2d2d;border-color:#444}.ep-game-container .game-stage{border-bottom-color:#444}.ep-game-container h2,.ep-game-container .game-share p{color:#f1f1f1}.ep-game-container .stage-counter,.ep-game-container #game-results p{color:#a0a0a0}.ep-game-container .choice-option{background:#3e3e3e;color:#f1f1f1;border-color:#555}.ep-game-container .choice-option:n