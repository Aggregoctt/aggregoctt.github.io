	<item>
		<title>Partisans deep in Russian rear spark chain reaction of delays for Moscow’s southern front in Ukraine</title>
		<link>https://euromaidanpress.com/2025/10/12/partisans-deep-in-russian-rear-sparks-chain-reaction-of-delays-for-moscows-southern-front-in-ukraine/</link>
		
		<dc:creator><![CDATA[Olena Mukhina]]></dc:creator>
		<pubDate>Sun, 12 Oct 2025 18:04:30 +0000</pubDate>
				<category><![CDATA[Latest news Ukraine]]></category>
		<category><![CDATA[ammunition]]></category>
		<category><![CDATA[Armed Forces of Ukraine]]></category>
		<category><![CDATA[artillery]]></category>
		<category><![CDATA[Atesh]]></category>
		<category><![CDATA[counteroffensive]]></category>
