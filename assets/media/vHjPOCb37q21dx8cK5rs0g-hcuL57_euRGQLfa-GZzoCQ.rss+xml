<div class="ep-quiz-container" id="nato-threat-quiz">
  <!-- Question 1 -->
  <div class="quiz-question is-hidden" data-qnum="1">
    <p class="question-counter">Question 1 of 5</p>
    <h2 id="according-to-general-grynkewich-when-could-a-coordinated-strike-by-russia-and-china-potentially-occur">According to General Grynkewich, when could a coordinated strike by Russia and China potentially occur?</h2>
    <div class="answers-container">
      <div class="answer-option">In the next six months</div>
      <div class="answer-option" data-correct="true">In 2027</div>
      <div class="answer-option">By 2030</div>
      <div class="answer-option">It is not mentioned</div>
    </div>
    <div class="feedback feedback-correct"><strong>Correct!</strong> The article cites General Alexus Grynkewich, who warned that Russia and China could launch a coordinated strike in 2027.</div>
    <div class="feedback feedback-incorrect"><strong>Not quite.</strong> The article mentions the year 2027 as the potential date for a coordinated strike, according to General Grynkewich's warning.</div>
  </div>

  <!-- Question 2 -->
  <div class="quiz-question is-hidden" data-qnum="2">
    <p class="question-counter">Question 2 of 5</p>
    <h2 id="what-key-characteristic-of-ukraines-defense-industry-does-eurocommissioner-kubilius-praise">What key characteristic of Ukraine's defense industry does Eurocommissioner Kubilius praise?</h2>
    <div class="answers-container">
      <div class="answer-option">Its large scale of production</div>
      <div class="answer-option">Its reliance on Soviet-era technology</div>
      <div class="answer-option" data-correct="true">Its flexibility and rapid, startup-like improvements</div>
      <div class="answer-option">Its strict bureaucratic structures</div>
    </div>
    <div class="feedback feedback-correct"><strong>Exactly!</strong> Kubilius highlights the impressive flexibility of Ukraine's defense industry, which is based on startups that constantly monitor and improve their equipment based on battlefield use.</div>
    <div class="feedback feedback-incorrect"><strong>Incorrect.</strong> The Eurocommissioner specifically praises the industry's flexibility and freedom from bureaucracy, comparing it to a startup ecosystem.</div>
  </div>

  <!-- Question 3 -->
  <div class="quiz-question is-hidden" data-qnum="3">
    <p class="question-counter">Question 3 of 5</p>
    <h2 id="what-is-the-main-goal-of-russias-military-rearmament-program-according-to-ukraines-defense-intelligence">What is the main goal of Russia's military rearmament program, according to Ukraine's Defense Intelligence?</h2>
    <div class="answers-container">
      <div class="answer-option">To modernize its navy</div>
      <div class="answer-option">To focus on cyber warfare</div>
      <div class="answer-option" data-correct="true">To be able to enter a direct military conflict with European countries</div>
      <div class="answer-option">To build defensive structures</div>
    </div>
    <div class="feedback feedback-correct"><strong>That's right!</strong> The article cites Kyrylo Budanov, who stated the rearmament program's goal is to allow Russia to engage in a direct military conflict with European nations.</div>
    <div class="feedback feedback-incorrect"><strong>Close!</strong> The primary goal mentioned by Ukraine's intelligence is to prepare for a direct conflict with European countries.</div>
  </div>

  <!-- Question 4 -->
  <div class="quiz-question is-hidden" data-qnum="4">
    <p class="question-counter">Question 4 of 5</p>
    <h2 id="according-to-eurocommissioner-kubilius-what-is-not-enough-for-western-allies-to-do-to-prepare-for-a-potential-invasion">According to Eurocommissioner Kubilius, what is NOT enough for Western allies to do to prepare for a potential invasion?</h2>
    <div class="answers-container">
      <div class="answer-option">Study Russian methods</div>
      <div class="answer-option" data-correct="true">Simply buy interceptor drones and learn to operate them</div>
      <div class="answer-option">Learn flexibility from Ukrainians</div>
      <div class="answer-option">Increase defense budgets</div>
    </div>
    <div class="feedback feedback-correct"><strong>Perfect!</strong> Kubilius warns that it's not enough to just buy equipment like interceptor drones; it's also crucial to learn the flexible, adaptive approach of the Ukrainian defense industry.</div>
    <div class="feedback feedback-incorrect"><strong>Not this time!</strong> The Eurocommissioner specifically states that "simply buying interceptor drones and learning to operate them is not enough."</div>
  </div>

  <!-- Question 5 -->
  <div class="quiz-question is-hidden" data-qnum="5">
    <p class="question-counter">Question 5 of 5</p>
    <h2 id="what-problem-has-recently-intensified-in-eu-countries-like-poland-denmark-and-norway-according-to-the-article">What problem has recently intensified in EU countries like Poland, Denmark, and Norway, according to the article?</h2>
    <div class="answers-container">
      <div class="answer-option">Cyberattacks on government websites</div>
      <div class="answer-option">Naval provocations</div>
      <div class="answer-option" data-correct="true">Increased Russian drone attacks or presence</div>
      <div class="answer-option">Economic sanctions</div>
    </div>
    <div class="feedback feedback-correct"><strong>You got it!</strong> The article states that in 2025, Russia has intensified drone attacks and presence over several EU countries, including Poland, Denmark, Norway, and the Baltic states.</div>
    <div class="feedback feedback-incorrect"><strong>Oops!</strong> The article highlights that Russia has intensified drone attacks and incursions over the skies of several EU countries.</div>
  </div>

  <!-- Results -->
  <div id="quiz-results" class="is-hidden">
    <h2 id="results-title"><span id=""></span></h2>
    <p id="results-text"></p>
    <img decoding="async" id="results-image" src="" alt="Quiz result image">
    <button id="restart-quiz-btn">Try Again</button>

    <!-- START OF SHARE BLOCK -->
    <div class="quiz-share">
        <p>Share your results!</p>
        <div class="share-row">
            <button id="quiz-native-share-btn" class="share-btn share-native" type="button"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 512 512" width="16" height="16" fill="currentColor"><path d="M503.691 189.836L327.495 13.639c-15.172-15.172-39.781-15.172-54.953 0s-15.172 39.781 0 54.953l93.678 93.678H192.001c-106.039 0-192 85.961-192 192v64c0 21.213 17.787 39.999 39.999 39.999 22.213 0 39.999-17.787 39.999-39.999v-64c0-61.758 50.242-111.999 111.999-111.999h174.219l-93.678 93.678c-15.172 15.172-15.172 39.781 0 54.953 7.586 7.586 17.522 11.379 27.477 11.379s19.891-3.793 27.477-11.379l176.196-176.197c15.172-15.172 15.172-39.781-.001-54.953z"></path></svg>Share</button>
            <button id="quiz-copy-link-btn" class="share-btn copy-link" type="button"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 512 512" width="16" height="16" fill="currentColor"><path d="M288 448H64V224h64V160H64c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H288c35.3 0 64-28.7 64-64V384H288v64zm-64-288H448V64H224v64zm224-64H224c-35.3 0-64 28.7-64 64V288c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V64c0-35.3-28.7-64-64-64z"></path></svg>Copy link</button>
        </div>
        <div id="copy-feedback" class="copy-feedback">Link copied to clipboard!</div>
    </div>
    <!-- END OF SHARE BLOCK -->
  </div>
</div><div data-fuse="incontent_1"></div>

<script>
(function(){
  const container = document.getElementById('nato-threat-quiz');
  if(!container) return;

  let score = 0;
  const questions = Array.from(container.querySelectorAll('.quiz-question'));
  const totalQuestions = questions.length;
  const resultsBlock = container.querySelector('#quiz-results');
  const restartBtn = container.querySelector('#restart-quiz-btn');

  function showQuestion(index){
    questions.forEach(q => q.classList.add('is-hidden'));
    const q = questions[index];
    if(q){
      q.classList.remove('is-hidden');
      q.classList.add('show');
    } else {
      showResults();
    }
  }

  function handleAnswer(qIndex, selected){
    const q = questions[qIndex];
    if(q.dataset.answered === 'true') return;
    q.dataset.answered = 'true';
    
    const isCorrect = selected.getAttribute('data-correct') === 'true';

    q.querySelectorAll('.answer-option').forEach(opt => opt.classList.add('disabled'));

    if(isCorrect){
      score++;
      selected.classList.add('correct');
      const fb = q.querySelector('.feedback-correct');
      if(fb) fb.style.display = 'block';
    } else {
      selected.classList.add('incorrect');
      const correct = q.querySelector('[data-correct="true"]');
      if(correct) correct.classList.add('correct');
      const fb = q.querySelector('.feedback-incorrect');
      if(fb) fb.style.display = 'block';
    }

    setTimeout(() => {
      if(qIndex + 1 < questions.length){
        showQuestion(qIndex + 1);
      } else {
        showResults();
      }
    }, 2500);
  }

  function showResults(){
    const title = container.querySelector('#results-title');
    const text = container.querySelector('#results-text');
    const img = container.querySelector('#results-image');

    text.textContent = `You answered ${score} out of ${totalQuestions} correctly!`;
    if(score <= 2){
      title.textContent = 'Stay Alert!';
      img.src = 'https://images.pexels.com/photos/1762851/pexels-photo-1762851.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1';
      img.alt = 'A person looking at a screen with data.';
    } else if(score <= 4){
      title.textContent = 'Well-Read Analyst!';
      img.src = 'https://images.pexels.com/photos/5926382/pexels-photo-5926382.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1';
      img.alt = 'A desk with multiple monitors showing intelligence data.';
    } else {
      title.textContent = 'Security Expert!';
      img.src = 'https://images.pexels.com/photos/7319106/pexels-photo-7319106.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1';
      img.alt = 'A strategic map with military figures on it.';
    }
    
    resultsBlock.classList.remove('is-hidden');
    resultsBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
    updateShareLinks(score, totalQuestions);
  }

  function updateShareLinks(score, total){
    const quizTitle = "Russia vs. NATO: Are You Prepared?";
    const shareText = `I scored ${score}/${total} on the "${quizTitle}" quiz! Test your knowledge on the potential threats.`;
    const pageUrl = window.location.href;

    // Native Share
    const nativeBtn = container.querySelector('#quiz-native-share-btn');
    if(navigator.share){
      nativeBtn.style.display = 'inline-flex';
      nativeBtn.onclick = () => {
        navigator.share({title: quizTitle, text: shareText, url: pageUrl}).catch(console.error);
      };
    } else {
      nativeBtn.style.display = 'none';
    }

    // Copy Link
    const copyBtn = container.querySelector('#quiz-copy-link-btn');
    const copyFeedback = container.querySelector('#copy-feedback');
    copyBtn.onclick = () => {
      navigator.clipboard.writeText(pageUrl).then(() => {
        copyFeedback.style.display = 'block';
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyFeedback.style.display = 'none';
          copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" fill="currentColor"><path d="M288 448H64V224h64V160H64c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H288c35.3 0 64-28.7 64-64V384H288v64zm-64-288H448V64H224v64zm224-64H224c-35.3 0-64 28.7-64 64V288c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V64c0-35.3-28.7-64-64-64z"/> Copy link`;
        }, 2000);
      }).catch(err => console.error('Failed to copy: ', err));
    };
  }

  function initQuiz(){
    score = 0;
    questions.forEach(q => {
      q.classList.add('is-hidden');
      delete q.dataset.answered;
      q.querySelectorAll('.answer-option').forEach(opt => {
        opt.classList.remove('correct', 'incorrect', 'disabled');
      });
      q.querySelector('.feedback-correct').style.display = 'none';
      q.querySelector('.feedback-incorrect').style.display = 'none';
    });
    resultsBlock.classList.add('is-hidden');

    questions.forEach((q, idx) => {
      q.querySelectorAll('.answer-option').forEach(opt => {
        opt.addEventListener('click', () => handleAnswer(idx, opt), { once: true });
      });
    });

    showQuestion(0);
  }
  
  if (restartBtn) {
    restartBtn.addEventListener('click', initQuiz);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initQuiz);
  } else {
    initQuiz();
  }
})();
</script>
<!-- END OF QUIZ CODE -->




<p></p>



