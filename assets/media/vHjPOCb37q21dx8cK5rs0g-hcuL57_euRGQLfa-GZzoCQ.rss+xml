                      <a href="https://euromaidanpress.com/2025/05/25/ukrainian-drones-hit-russian-military-train-with-fuel-in-occupied-zaporizhzhia-oblast-video/" target="_blank" class="read-also__title">
                        <h3 id="ukrainian-drones-hit-russian-military-train-with-fuel-in-occupied-zaporizhzhia-oblast-video">Ukrainian drones hit Russian military train with fuel in occupied Zaporizhzhia Oblast (video)</h3>
                      </a>
                                      </li>
                  
                        
                                  <li>
                                        
                                        
                      <a href="https://euromaidanpress.com/2025/07/01/ukraine-hits-russian-military-train-just-days-after-first-sabotage-in-partially-occupied-zaporizhzhia-oblast/" target="_blank" class="read-also__title">
                        <h3 id="ukraine-hits-russian-military-train-just-days-after-first-sabotage-in-partially-occupied-zaporizhzhia-oblast">Ukraine hits Russian military train just days after first sabotage in partially occupied Zaporizhzhia Oblast</h3>
                      </a>
