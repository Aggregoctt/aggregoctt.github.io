</div>

<script>
(function(){
  const container = document.getElementById('drone-wall-quiz');
  if(!container) return;

  let score = 0;
  const questions = Array.from(container.querySelectorAll('.quiz-question'));
  const totalQuestions = questions.length;
  const resultsBlock = container.querySelector('#quiz-results');
  const restartBtn = container.querySelector('#restart-quiz-btn');

  function showQuestion(index){
    questions.forEach(q => q.classList.add('is-hidden'));
    const q = questions[index];
    if(q){
      q.classList.remove('is-hidden');
      q.classList.add('show');
    } else {
      showResults();
    }
  }

  function handleAnswer(qIndex, selected){
    const q = questions[qIndex];
    if(q.dataset.answered === 'true') return;
    q.dataset.answered = 'true';
    
    const isCorrect = selected.getAttribute('data-correct') === 'true';

    q.querySelectorAll('.answer-option').forEach(opt => opt.classList.add('disabled'));

    if(isCorrect){
      score++;
      selected.classList.add('correct');
      const fb = q.querySelector('.feedback-correct');
      if(fb) fb.style.display = 'block';
    } else {
      selected.classList.add('incorrect');
      const correct = q.querySelector('[data-correct="true"]');
      if(correct) correct.classList.add('correct');
      const fb = q.querySelector('.feedback-incorrect');
      if(fb) fb.style.display = 'block';
    }

    setTimeout(() => {
      if(qIndex + 1 < questions.length){
        showQuestion(qIndex + 1);
      } else {
        showResults();
      }
    }, 2500);
  }

  function showResults(){
    const title = container.querySelector('#results-title');
    const text = container.querySelector('#results-text');
    const img = container.querySelector('#results-image');

    text.textContent = `You answered ${score} out of ${totalQuestions} correctly!`;
    if(score <= 2){
      title.textContent = 'Good Effort!';
      img.src = 'https://euromaidanpress.com/wp-content/uploads/2025/03/quizwall2.webp'
      img.alt = 'A single drone in the sky.';
    } else if(score <= 4){
      title.textContent = 'Great Knowledge!';
      img.src = 'https://euromaidanpress.com/wp-content/uploads/2025/03/quizwall.webp'
      img.alt = 'A person operating a drone controller.';
    } else {
      title.textContent = 'Drone Defense Expert!';
      img.src = 'https://euromaidanpress.com/wp-content/uploads/2025/03/quizwall1.webp'
      img.alt = 'Multiple drones flying in formation.';
    }
    
    resultsBlock.classList.remove('is-hidden');
    resultsBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
    updateShareLinks(score, totalQuestions);
  }

  function updateShareLinks(score, total){
    const quizTitle = "EU's Drone Wall Quiz";
    const shareText = `I scored ${score}/${total} on the "${quizTitle}"! How well do you know the future of border defense?`;
    const pageUrl = window.location.href;

    // Native Share
    const nativeBtn = container.querySelector('#quiz-native-share-btn');
    if(navigator.share){
      nativeBtn.style.display = 'inline-flex';
      nativeBtn.onclick = () => {
        navigator.share({title: quizTitle, text: shareText, url: pageUrl}).catch(console.error);
      };
    } else {
      nativeBtn.style.display = 'none';
    }

    // Copy Link
    const copyBtn = container.querySelector('#quiz-copy-link-btn');
    const copyFeedback = container.querySelector('#copy-feedback');
    copyBtn.onclick = () => {
      navigator.clipboard.writeText(pageUrl).then(() => {
        copyFeedback.style.display = 'block';
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyFeedback.style.display = 'none';
          copyBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" fill="currentColor"><path d="M288 448H64V224h64V160H64c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H288c35.3 0 64-28.7 64-64V384H288v64zm-64-288H448V64H224v64zm224-64H224c-35.3 0-64 28.7-64 64V288c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V64c0-35.3-28.7-64-64-64z"/> Copy link`;
        }, 2000);
      }).catch(err => console.error('Failed to copy: ', err));
    };
  }

  function initQuiz(){
    score = 0;
    questions.forEach(q => {
      q.classList.add('is-hidden');
      delete q.dataset.answered;
      q.querySelectorAll('.answer-option').forEach(opt => {
        opt.classList.remove('correct', 'incorrect', 'disabled');
      });
      q.querySelector('.feedback-correct').style.display = 'none';
      q.querySelector('.feedback-incorrect').style.display = 'none';
    });
    resultsBlock.classList.add('is-hidden');

    questions.forEach((q, idx) => {
      q.querySelectorAll('.answer-option').forEach(opt => {
        opt.addEventListener('click', () => handleAnswer(idx, opt), { once: true });
      });
    });

    showQuestion(0);
  }
  
  if (restartBtn) {
    restartBtn.addEventListener('click', initQuiz);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initQuiz);
  } else {
    initQuiz();
  }
})();
</script>
<!-- END OF QUIZ CODE -->


